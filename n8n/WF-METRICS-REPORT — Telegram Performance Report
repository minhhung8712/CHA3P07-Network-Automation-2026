        "jsCode": "// Parse lenh Telegram: /report, /report scan, /report brute, /report approve\nconst msg = $json.message || {};\nconst text = String(msg.text || '').trim();\nconst chatId = msg.chat?.id;\n\nconst lower = text.toLowerCase();\nlet scenario = 'ALL';\n\nif (lower === '/report scan' || lower === '/report_scan') scenario = 'BLOCK_SCAN';\nelse if (lower === '/report brute' || lower === '/report_brute') scenario = 'BLOCK_BRUTE';\nelse if (lower === '/report approve' || lower === '/report_approve') scenario = 'APPROVE_MAC';\n\nreturn [{\n  json: {\n    command: text,\n    chat_id: chatId,\n    is_report: lower === '/report' || lower.startsWith('/report ') || lower.startsWith('/report_'),\n    scenario\n  }\n}];"
