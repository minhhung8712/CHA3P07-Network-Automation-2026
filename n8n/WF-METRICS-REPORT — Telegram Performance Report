      "parameters": {
        "jsCode": "// ================================================================\n// BUILD REPORT - COMPACT PERFORMANCE REPORT\n// ================================================================\n\nconst request = $('Parse & Advance Offset').first().json;\nconst scenario = request.scenario || 'ALL';\nconst chatId = request.chat_id;\n\nconst text =\n  $('Extract Metrics Text').first()?.json?.data || '';\n\n// ================================================================\n// READ JSONL\n// ================================================================\n\nconst records = text\n  .split(/\\r?\\n/)\n  .map(s => s.trim())\n  .filter(Boolean)\n  .map(line => {\n    try {\n      return JSON.parse(line);\n    } catch {\n      return null;\n    }\n  })\n  .filter(Boolean);\n\n// ================================================================\n// FILTER SCENARIO\n// ================================================================\n\nconst filtered =\n  scenario === 'ALL'\n    ? records\n    : records.filter(r => r.scenario === scenario);\n\nconst scenarioLabel = {\n  ALL: 'TẤT CẢ KỊCH BẢN',\n  BLOCK_SCAN: 'PORT SCAN',\n  BLOCK_BRUTE: 'BRUTE FORCE',\n  APPROVE_MAC: 'PHÊ DUYỆT THIẾT BỊ'\n}[scenario] || scenario;\n\nconst scenarioIcon = {\n  ALL: '📊',\n  BLOCK_SCAN: '🛡',\n  BLOCK_BRUTE: '🔐',\n  APPROVE_MAC: '🖥'\n}[scenario] || '🛡';\n\nif (!filtered.length) {\n  return [{\n    json: {\n      chat_id: chatId,\n      report_text:\n`📊 BÁO CÁO HIỆU SUẤT\n\n${scenarioIcon} ${scenarioLabel}\n\nChưa có dữ liệu đo lường.`\n    }\n  }];\n}\n\n// ================================================================\n// GET REAL DURATION\n//\n// APPROVE_MAC:\n//   uu tien automation_after_approval_seconds\n//\n// SCAN / BRUTE:\n//   uu tien total_processing_seconds\n//\n// Neu duration qua lon -> thu tinh lai bang timestamp.\n// ================================================================\n\nfunction getDurationSeconds(r) {\n\n  // DHCP: automation sau khi admin approve\n  if (r.scenario === 'APPROVE_MAC') {\n\n    const autoSec =\n      Number(r.automation_after_approval_seconds);\n\n    if (\n      Number.isFinite(autoSec) &&\n      autoSec >= 0 &&\n      autoSec < 3600\n    ) {\n      return autoSec;\n    }\n\n    const approved =\n      Number(r.approved_at_ms);\n\n    const finished =\n      Number(\n        r.processing_finished_at_ms ||\n        r.finished_at_ms\n      );\n\n    if (\n      Number.isFinite(approved) &&\n      Number.isFinite(finished) &&\n      finished >= approved\n    ) {\n      const sec = (finished - approved) / 1000;\n\n      if (sec < 3600) {\n        return sec;\n      }\n    }\n  }\n\n  // Normal metric\n  const total =\n    Number(r.total_processing_seconds);\n\n  // Bao ve khoi Unix timestamp bi ghi nham\n  if (\n    Number.isFinite(total) &&\n    total >= 0 &&\n    total < 3600\n  ) {\n    return total;\n  }\n\n  // ================================================================\n  // FALLBACK: tinh lai tu timestamp\n  // ================================================================\n\n  const start =\n    Number(\n      r.analyzer_detected_at_ms ||\n      r.processing_started_at_ms ||\n      r.process_started_at_ms ||\n      r.started_at_ms\n    );\n\n  const end =\n    Number(\n      r.processing_finished_at_ms ||\n      r.finished_at_ms\n    );\n\n  if (\n    Number.isFinite(start) &&\n    Number.isFinite(end) &&\n    end >= start\n  ) {\n\n    const sec = (end - start) / 1000;\n\n    if (sec < 3600) {\n      return sec;\n    }\n  }\n\n  // Metric loi / khong the suy ra\n  return null;\n}\n\n// ================================================================\n// VALID RECORDS\n// ================================================================\n\nconst successRecords =\n  filtered.filter(r => r.status === 'success');\n\nconst failedRecords =\n  filtered.filter(r => r.status !== 'success');\n\nconst validRecords =\n  successRecords\n    .map(r => ({\n      record: r,\n      duration: getDurationSeconds(r)\n    }))\n    .filter(x =>\n      Number.isFinite(x.duration)\n    );\n\nconst times =\n  validRecords\n    .map(x => x.duration)\n    .sort((a, b) => a - b);\n\n// ================================================================\n// STATISTICS\n// ================================================================\n\nfunction average(arr) {\n  if (!arr.length) return null;\n\n  return (\n    arr.reduce((sum, n) => sum + n, 0) /\n    arr.length\n  );\n}\n\nfunction median(arr) {\n  if (!arr.length) return null;\n\n  const mid =\n    Math.floor(arr.length / 2);\n\n  return arr.length % 2\n    ? arr[mid]\n    : (arr[mid - 1] + arr[mid]) / 2;\n}\n\nfunction percentile(arr, p) {\n  if (!arr.length) return null;\n\n  const index =\n    Math.ceil((p / 100) * arr.length) - 1;\n\n  return arr[\n    Math.max(\n      0,\n      Math.min(index, arr.length - 1)\n    )\n  ];\n}\n\nconst avg = average(times);\nconst med = median(times);\n\nconst min =\n  times.length\n    ? times[0]\n    : null;\n\nconst max =\n  times.length\n    ? times[times.length - 1]\n    : null;\n\nconst p95 =\n  percentile(times, 95);\n\nconst successRate =\n  filtered.length\n    ? (\n        successRecords.length /\n        filtered.length\n      ) * 100\n    : 0;\n\n// ================================================================\n// FORMAT DURATION\n// ================================================================\n\nfunction formatDuration(seconds) {\n\n  const sec = Number(seconds);\n\n  if (!Number.isFinite(sec)) {\n    return 'N/A';\n  }\n\n  // < 1 second\n  if (sec < 1) {\n    return `${Math.round(sec * 1000)} ms`;\n  }\n\n  // < 60 seconds\n  if (sec < 60) {\n    return `${sec.toFixed(2)}s`;\n  }\n\n  // >= 60 seconds\n  const minutes =\n    Math.floor(sec / 60);\n\n  const remain =\n    sec % 60;\n\n  return `${minutes}m ${remain.toFixed(1)}s`;\n}\n\n// ================================================================\n// DATE FORMAT\n// ================================================================\n\nfunction formatDateTime(value) {\n\n  if (!value) {\n    return 'N/A';\n  }\n\n  const date =\n    new Date(value);\n\n  if (Number.isNaN(date.getTime())) {\n    return 'N/A';\n  }\n\n  return new Intl.DateTimeFormat(\n    'vi-VN',\n    {\n      timeZone: 'Asia/Ho_Chi_Minh',\n      day: '2-digit',\n      month: '2-digit',\n      year: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: false\n    }\n  ).format(date);\n}\n\n// ================================================================\n// LATEST RECORD\n// ================================================================\n\nconst latest =\n  [...filtered]\n    .sort((a, b) =>\n      Number(\n        b.processing_finished_at_ms ||\n        b.finished_at_ms ||\n        0\n      ) -\n      Number(\n        a.processing_finished_at_ms ||\n        a.finished_at_ms ||\n        0\n      )\n    )[0];\n\nconst latestDuration =\n  getDurationSeconds(latest);\n\n// ================================================================\n// LATEST DEVICE INFORMATION\n// ================================================================\n\nlet latestIdentity = '';\n\nif (scenario === 'APPROVE_MAC') {\n\n  latestIdentity =\n`MAC: ${latest?.mac || 'N/A'}\nIP: ${latest?.ip || 'N/A'}`;\n\n} else {\n\n  latestIdentity =\n`IP: ${latest?.ip || 'N/A'}`;\n}\n\n// ================================================================\n// METRIC LABEL\n// ================================================================\n\nlet metricLabel =\n  '⏱ THỜI GIAN XỬ LÝ';\n\nif (scenario === 'APPROVE_MAC') {\n  metricLabel =\n    '⏱ TỰ ĐỘNG HÓA SAU KHI APPROVE';\n}\n\n// ================================================================\n// INVALID METRIC WARNING\n// ================================================================\n\nconst invalidCount =\n  successRecords.length -\n  validRecords.length;\n\nlet warning = '';\n\nif (invalidCount > 0) {\n\n  warning =\n`\\n⚠️ ${invalidCount} bản ghi có thời gian không hợp lệ và không được tính thống kê.\\n`;\n}\n\n// ================================================================\n// BUILD COMPACT REPORT\n// ================================================================\n\nconst report =\n`📊 BÁO CÁO HIỆU SUẤT\n\n${scenarioIcon} ${scenarioLabel}\n\n✅ ${successRecords.length}/${filtered.length} thành công • ${successRate.toFixed(0)}%\n${warning}\n${metricLabel}\nTB: ${formatDuration(avg)}\nMedian: ${formatDuration(med)}\nMin: ${formatDuration(min)} • Max: ${formatDuration(max)}\nP95: ${formatDuration(p95)}\n\n🔎 GẦN NHẤT\n${latestIdentity}\nThời gian: ${formatDuration(latestDuration)}\nHoàn thành: ${formatDateTime(\n  latest?.processing_finished_at ||\n  latest?.finished_at\n)}`;\n\n// ================================================================\n// OUTPUT\n// ================================================================\n\nreturn [{\n  json: {\n\n    chat_id: chatId,\n    scenario,\n\n    total_records:\n      filtered.length,\n\n    success_count:\n      successRecords.length,\n\n    failed_count:\n      failedRecords.length,\n\n    invalid_duration_count:\n      invalidCount,\n\n    success_rate:\n      Number(\n        successRate.toFixed(2)\n      ),\n\n    average_seconds:\n      avg,\n\n    median_seconds:\n      med,\n\n    min_seconds:\n      min,\n\n    max_seconds:\n      max,\n\n    p95_seconds:\n      p95,\n\n    report_text:\n      report\n  }\n}];"
      },
