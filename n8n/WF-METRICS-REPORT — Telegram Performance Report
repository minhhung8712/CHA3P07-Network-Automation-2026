    {
      "parameters": {
        "jsCode": "// ================================================================\n// PARSE + ADVANCE REPORT OFFSET\n// - Lan dau offset=0: dong bo backlog, KHONG xu ly report cu\n// - Cac lan sau: chi lay /report moi nhat trong batch hien tai\n// - Luon tao next_offset de ghi vao report_offset.txt\n// ================================================================\n\nconst updates = Array.isArray($json.result)\n  ? $json.result\n  : [];\n\nconst currentOffset = Number(\n  $('Prepare Poll').first()?.json?.offset || 0\n);\n\n// Khong co update moi\nif (updates.length === 0) {\n  return [{\n    json: {\n      has_report: false,\n      sync_only: false,\n      current_offset: currentOffset,\n      next_offset: currentOffset,\n      offset_content: String(currentOffset)\n    }\n  }];\n}\n\n// Sap xep theo update_id\nupdates.sort(\n  (a, b) =>\n    Number(a.update_id || 0) -\n    Number(b.update_id || 0)\n);\n\nconst updateIds = updates\n  .map(u => Number(u.update_id))\n  .filter(Number.isFinite);\n\nconst maxUpdateId = Math.max(...updateIds);\nconst nextOffset = maxUpdateId + 1;\n\n// ================================================================\n// LAN DAU TIEN\n// offset = 0 -> Telegram dang tra backlog cu\n// Chi dong bo cursor den update moi nhat, KHONG gui report\n// ================================================================\n\nif (currentOffset === 0) {\n  return [{\n    json: {\n      has_report: false,\n      sync_only: true,\n\n      current_offset: 0,\n      next_offset: nextOffset,\n      offset_content: String(nextOffset),\n\n      skipped_backlog: updates.length\n    }\n  }];\n}\n\n// ================================================================\n// CAC LAN SAU: TIM /report TRONG BATCH MOI\n// ================================================================\n\nconst reports = [];\n\nfor (const u of updates) {\n  const msg = u.message;\n\n  if (!msg?.text) continue;\n\n  const text = String(msg.text).trim();\n\n  // Chi nhan /report\n  if (!/^\\/report(?:@\\w+)?(?:\\s|$)/i.test(text)) {\n    continue;\n  }\n\n  const lower = text.toLowerCase();\n\n  let scenario = 'ALL';\n\n  if (/\\bscan\\b/.test(lower)) {\n    scenario = 'BLOCK_SCAN';\n  }\n  else if (/\\bbrute\\b/.test(lower)) {\n    scenario = 'BLOCK_BRUTE';\n  }\n  else if (\n    /\\bapprove\\b/.test(lower) ||\n    /\\bdhcp\\b/.test(lower)\n  ) {\n    scenario = 'APPROVE_MAC';\n  }\n\n  reports.push({\n    update_id: Number(u.update_id),\n    command: text,\n    scenario,\n    chat_id: msg.chat?.id\n  });\n}\n\n// Khong co /report trong batch moi\nif (reports.length === 0) {\n  return [{\n    json: {\n      has_report: false,\n      sync_only: false,\n\n      current_offset: currentOffset,\n      next_offset: nextOffset,\n      offset_content: String(nextOffset)\n    }\n  }];\n}\n\n// Neu co nhieu command, lay command MOI NHAT\nreports.sort(\n  (a, b) => b.update_id - a.update_id\n);\n\nconst latest = reports[0];\n\nreturn [{\n  json: {\n    has_report: true,\n    sync_only: false,\n\n    command: latest.command,\n    scenario: latest.scenario,\n    chat_id: latest.chat_id,\n    update_id: latest.update_id,\n\n    current_offset: currentOffset,\n    next_offset: nextOffset,\n\n    // Dung de ghi report_offset.txt\n    offset_content: String(nextOffset)\n  }\n}];"
      },
