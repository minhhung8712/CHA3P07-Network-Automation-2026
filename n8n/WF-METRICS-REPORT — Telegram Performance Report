      "parameters": {
        "jsCode": "// ================================================================\n// BUILD REPORT - BAO CAO HIEU SUAT TU DONG HOA\n// ================================================================\n\nconst request = $('Parse Report Command').first().json;\nconst scenario = request.scenario || 'ALL';\nconst chatId = request.chat_id;\n\nconst text = $('Extract Metrics Text').first()?.json?.data || '';\n\n// ===== DOC FILE JSONL =====\nconst records = text\n  .split(/\\r?\\n/)\n  .map(s => s.trim())\n  .filter(Boolean)\n  .map(line => {\n    try {\n      return JSON.parse(line);\n    } catch {\n      return null;\n    }\n  })\n  .filter(Boolean);\n\n// ===== LOC THEO KICH BAN =====\nconst filtered = scenario === 'ALL'\n  ? records\n  : records.filter(r => r.scenario === scenario);\n\n// ===== KHONG CO DU LIEU =====\nif (filtered.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      report_text:\n`📊 BÁO CÁO HIỆU SUẤT TỰ ĐỘNG HÓA\n\nKịch bản: ${scenario}\n\nChưa có dữ liệu đo lường.`\n    }\n  }];\n}\n\n// ===== CHI LAY CAC LAN XU LY THANH CONG CO THOI GIAN HOP LE =====\nconst successRecords = filtered.filter(r =>\n  r.status === 'success' &&\n  Number.isFinite(Number(r.total_processing_seconds))\n);\n\nconst failedRecords = filtered.filter(r =>\n  r.status !== 'success'\n);\n\nconst times = successRecords\n  .map(r => Number(r.total_processing_seconds))\n  .sort((a, b) => a - b);\n\n// ===== HAM THONG KE =====\nconst average = arr =>\n  arr.length\n    ? arr.reduce((sum, n) => sum + n, 0) / arr.length\n    : null;\n\nconst median = arr => {\n  if (!arr.length) return null;\n\n  const mid = Math.floor(arr.length / 2);\n\n  return arr.length % 2\n    ? arr[mid]\n    : (arr[mid - 1] + arr[mid]) / 2;\n};\n\nconst percentile = (arr, p) => {\n  if (!arr.length) return null;\n\n  const index = Math.ceil((p / 100) * arr.length) - 1;\n\n  return arr[\n    Math.max(0, Math.min(index, arr.length - 1))\n  ];\n};\n\n// ===== DINH DANG THOI GIAN =====\n// Input = giay\nfunction formatDuration(seconds) {\n  const sec = Number(seconds);\n\n  if (!Number.isFinite(sec)) {\n    return 'N/A';\n  }\n\n  const ms = Math.round(sec * 1000);\n\n  // Duoi 1 giay\n  if (sec < 1) {\n    return `${ms} ms (${sec.toFixed(3)} giây)`;\n  }\n\n  // Duoi 60 giay\n  if (sec < 60) {\n    return `${sec.toFixed(3)} giây (${ms.toLocaleString('en-US')} ms)`;\n  }\n\n  // Tu 1 phut tro len\n  const minutes = Math.floor(sec / 60);\n  const remainingSeconds = sec % 60;\n\n  return `${minutes} phút ${remainingSeconds.toFixed(3)} giây ` +\n         `(${sec.toFixed(3)} giây | ${ms.toLocaleString('en-US')} ms)`;\n}\n\n// ===== DINH DANG NGAY GIO VN =====\nfunction formatDateTime(value) {\n  if (!value) return 'N/A';\n\n  const date = new Date(value);\n\n  if (Number.isNaN(date.getTime())) {\n    return String(value);\n  }\n\n  return new Intl.DateTimeFormat('vi-VN', {\n    timeZone: 'Asia/Ho_Chi_Minh',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit',\n    hour12: false\n  }).format(date);\n}\n\n// ===== THONG KE =====\nconst avg = average(times);\nconst med = median(times);\nconst min = times.length ? times[0] : null;\nconst max = times.length ? times[times.length - 1] : null;\nconst p95 = percentile(times, 95);\n\nconst successRate =\n  filtered.length > 0\n    ? (successRecords.length / filtered.length) * 100\n    : 0;\n\n// ===== LAN XU LY GAN NHAT =====\nconst latest = [...filtered].sort((a, b) =>\n  Number(\n    b.processing_finished_at_ms ||\n    b.finished_at_ms ||\n    0\n  ) -\n  Number(\n    a.processing_finished_at_ms ||\n    a.finished_at_ms ||\n    0\n  )\n)[0];\n\n// ===== TEN KICH BAN =====\nconst scenarioLabel = {\n  ALL: 'TẤT CẢ KỊCH BẢN',\n  BLOCK_SCAN: 'PHÁT HIỆN & CHẶN PORT SCAN',\n  BLOCK_BRUTE: 'PHÁT HIỆN & CHẶN BRUTE FORCE',\n  APPROVE_MAC: 'PHÊ DUYỆT THIẾT BỊ / MAC'\n}[scenario] || scenario;\n\n// ===== TAO NOI DUNG REPORT =====\nconst report =\n`📊 BÁO CÁO HIỆU SUẤT TỰ ĐỘNG HÓA\n\n🛡 Kịch bản: ${scenarioLabel}\n\n📌 TỔNG QUAN\nTổng số lần xử lý: ${filtered.length}\nThành công: ${successRecords.length}\nThất bại: ${failedRecords.length}\nTỷ lệ thành công: ${successRate.toFixed(1)}%\n\n⏱ THỜI GIAN XỬ LÝ END-TO-END\nTừ lúc WF-ANALYZER phát hiện → Ansible xử lý thành công\n\nTrung bình:\n${formatDuration(avg)}\n\nTrung vị:\n${formatDuration(med)}\n\nNhanh nhất:\n${formatDuration(min)}\n\nChậm nhất:\n${formatDuration(max)}\n\nP95:\n${formatDuration(p95)}\n\n🔎 LẦN XỬ LÝ GẦN NHẤT\n\nIP: ${latest?.ip || 'N/A'}\nEvent ID: ${latest?.event_id || 'N/A'}\nTrạng thái: ${(latest?.status || 'unknown').toUpperCase()}\n\nThời gian xử lý:\n${formatDuration(latest?.total_processing_seconds)}\n\nPhát hiện lúc:\n${formatDateTime(\n  latest?.analyzer_detected_at ||\n  latest?.started_at\n)}\n\nHoàn thành lúc:\n${formatDateTime(\n  latest?.processing_finished_at ||\n  latest?.finished_at\n)}`;\n\n// ===== OUTPUT =====\nreturn [{\n  json: {\n    chat_id: chatId,\n    scenario,\n\n    total_records: filtered.length,\n    success_count: successRecords.length,\n    failed_count: failedRecords.length,\n    success_rate: Number(successRate.toFixed(2)),\n\n    average_seconds: avg,\n    median_seconds: med,\n    min_seconds: min,\n    max_seconds: max,\n    p95_seconds: p95,\n\n    report_text: report\n  }\n}];"
      },
