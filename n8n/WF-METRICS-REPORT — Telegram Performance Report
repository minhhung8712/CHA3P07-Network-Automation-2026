      "parameters": {
        "jsCode": "// ================================================================\n// PARSE REPORT COMMAND\n// Chi xu ly /report MOI NHAT va KHONG doc lai update cu\n// ================================================================\n\nconst s = $getWorkflowStaticData('global');\nconst updates = Array.isArray($json.result) ? $json.result : [];\n\ns.report_offset = Number(s.report_offset || 0);\ns.last_report_update_id = Number(s.last_report_update_id || 0);\n\nif (updates.length === 0) {\n  return [];\n}\n\n// Sap xep tang dan\nupdates.sort(\n  (a, b) => Number(a.update_id || 0) - Number(b.update_id || 0)\n);\n\n// Telegram batch hien tai ket thuc o update nao?\nconst maxUpdateId = Math.max(\n  ...updates.map(u => Number(u.update_id || 0))\n);\n\n// LAN SAU HTTP se bat dau tu update tiep theo\ns.report_offset = maxUpdateId + 1;\n\nconst reports = [];\n\nfor (const u of updates) {\n  const updateId = Number(u.update_id || 0);\n\n  // Da xu ly roi -> bo\n  if (updateId <= s.last_report_update_id) {\n    continue;\n  }\n\n  const msg = u.message;\n  if (!msg?.text) continue;\n\n  const text = String(msg.text).trim();\n\n  // Chi nhan /report\n  if (!/^\\/report(?:@\\w+)?(?:\\s|$)/i.test(text)) {\n    continue;\n  }\n\n  const lower = text.toLowerCase();\n\n  let scenario = 'ALL';\n\n  if (/\\bscan\\b/.test(lower)) {\n    scenario = 'BLOCK_SCAN';\n  }\n  else if (/\\bbrute\\b/.test(lower)) {\n    scenario = 'BLOCK_BRUTE';\n  }\n  else if (\n    /\\bapprove\\b/.test(lower) ||\n    /\\bdhcp\\b/.test(lower)\n  ) {\n    scenario = 'APPROVE_MAC';\n  }\n\n  reports.push({\n    update_id: updateId,\n    command: text,\n    scenario,\n    chat_id: msg.chat?.id\n  });\n}\n\n// Khong co command report moi\nif (reports.length === 0) {\n  return [];\n}\n\n// Lay command MOI NHAT\nreports.sort(\n  (a, b) => b.update_id - a.update_id\n);\n\nconst latest = reports[0];\n\n// Danh dau command nay da xu ly\ns.last_report_update_id = latest.update_id;\n\nreturn [{\n  json: {\n    command: latest.command,\n    scenario: latest.scenario,\n    chat_id: latest.chat_id,\n    update_id: latest.update_id,\n\n    debug_next_offset: s.report_offset,\n    debug_last_report_update_id:\n      s.last_report_update_id\n  }\n}];"
      },
