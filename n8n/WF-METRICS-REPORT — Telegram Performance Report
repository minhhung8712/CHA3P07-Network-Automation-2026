        "jsCode": "// ================================================================\n// PREPARE REPORT POLL\n// Doc offset tu report_offset.txt\n// ================================================================\n\nconst raw = String(\n  $('Extract Report Offset').first()?.json?.data || '0'\n).trim();\n\nlet offset = Number.parseInt(raw, 10);\n\nif (!Number.isFinite(offset) || offset < 0) {\n  offset = 0;\n}\n\nreturn [{\n  json: {\n    offset\n  }\n}];"
