      "parameters": {
        "jsCode": "// ================================================================\n// BUILD METRICS REPORT\n// Doc processing_metrics.jsonl va tao report theo scenario\n// ================================================================\n\nconst request = $('Parse Report Command').first().json;\nconst scenario = request.scenario || 'ALL';\nconst chatId = request.chat_id;\n\nconst text = $('Extract Metrics Text').first()?.json?.data || '';\n\nconst records = text\n  .split(/\\r?\\n/)\n  .map(s => s.trim())\n  .filter(Boolean)\n  .map(line => {\n    try { return JSON.parse(line); }\n    catch { return null; }\n  })\n  .filter(Boolean);\n\nconst filtered = scenario === 'ALL'\n  ? records\n  : records.filter(r => r.scenario === scenario);\n\nconst valid = filtered.filter(r =>\n  r.status === 'success' &&\n  Number.isFinite(Number(r.total_processing_seconds))\n);\n\nif (filtered.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      report_text:\n`📊 SECURITY AUTOMATION REPORT\n\nScenario: ${scenario}\n\nChưa có dữ liệu đo lường trong processing_metrics.jsonl.`\n    }\n  }];\n}\n\nconst times = valid\n  .map(r => Number(r.total_processing_seconds))\n  .sort((a, b) => a - b);\n\nconst avg = arr => arr.length\n  ? arr.reduce((a, b) => a + b, 0) / arr.length\n  : null;\n\nconst median = arr => {\n  if (!arr.length) return null;\n  const m = Math.floor(arr.length / 2);\n  return arr.length % 2 ? arr[m] : (arr[m - 1] + arr[m]) / 2;\n};\n\nconst percentile = (arr, p) => {\n  if (!arr.length) return null;\n  const i = Math.max(0, Math.min(arr.length - 1, Math.ceil((p / 100) * arr.length) - 1));\n  return arr[i];\n};\n\nconst average = avg(times);\nconst med = median(times);\nconst min = times.length ? times[0] : null;\nconst max = times.length ? times[times.length - 1] : null;\nconst p95 = percentile(times, 95);\n\nconst successCount = valid.length;\nconst failedCount = filtered.filter(r => r.status !== 'success').length;\nconst successRate = filtered.length ? (successCount / filtered.length) * 100 : 0;\n\nconst latest = [...filtered].sort((a, b) =>\n  Number(b.processing_finished_at_ms || b.finished_at_ms || 0) -\n  Number(a.processing_finished_at_ms || a.finished_at_ms || 0)\n)[0];\n\nconst sec = n => Number.isFinite(Number(n))\n  ? `${Number(n).toFixed(3)} s`\n  : 'N/A';\n\nconst scenarioLabel = {\n  ALL: 'ALL',\n  BLOCK_SCAN: 'BLOCK SCAN',\n  BLOCK_BRUTE: 'BLOCK BRUTE FORCE',\n  APPROVE_MAC: 'APPROVE MAC'\n}[scenario] || scenario;\n\nconst report =\n`📊 SECURITY AUTOMATION REPORT\n\nScenario: ${scenarioLabel}\n\nExecutions: ${filtered.length}\nSuccess: ${successCount}\nFailed: ${failedCount}\nSuccess rate: ${successRate.toFixed(1)}%\n\n⏱ END-TO-END PROCESSING TIME\nAnalyzer detected → Automation success\n\nAverage: ${sec(average)}\nMedian: ${sec(med)}\nFastest: ${sec(min)}\nSlowest: ${sec(max)}\nP95: ${sec(p95)}\n\n🔎 LATEST EXECUTION\nIP: ${latest?.ip || 'N/A'}\nEvent ID: ${latest?.event_id || 'N/A'}\nStatus: ${(latest?.status || 'unknown').toUpperCase()}\nTime: ${sec(latest?.total_processing_seconds)}\nDetected: ${latest?.analyzer_detected_at || latest?.started_at || 'N/A'}\nFinished: ${latest?.processing_finished_at || latest?.finished_at || 'N/A'}`;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    scenario,\n    total_records: filtered.length,\n    success_count: successCount,\n    failed_count: failedCount,\n    average_seconds: average,\n    median_seconds: med,\n    min_seconds: min,\n    max_seconds: max,\n    p95_seconds: p95,\n    report_text: report\n  }\n}];"
      },
