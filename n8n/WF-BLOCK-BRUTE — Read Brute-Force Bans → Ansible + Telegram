      "parameters": {
        "jsCode": "// ================================================================\n// WF-BLOCK-BRUTE\n// FILTER NEW IPs + LAB RESET\n// Production: van dedupe IP de tranh block trung\n// Lab: cho phep reset cung IP de thu nghiem nhieu lan\n// ================================================================\n\nconst content = $('Extract Ban Text').first()?.json?.data || '';\nconst ips = content.split(/\\r?\\n/).map(s => s.trim()).filter(Boolean);\n\nconst staticData = $getWorkflowStaticData('global');\n\n// Session rieng cua WF-BLOCK-BRUTE\nstaticData.blocked = Array.isArray(staticData.blocked)\n  ? staticData.blocked\n  : [];\n\nstaticData.labResetTokens =\n  staticData.labResetTokens || {};\n\n// ================================================================\n// LAB RESET\n// Muon test lai cung IP -> doi token\n// ================================================================\n\nconst LAB_RESET = {\n  enabled: true,\n\n  // DOI THANH IP MAY DUNG DE TEST BRUTE FORCE\n  ip: '192.168.183.133',\n\n  // Moi lan test lai chi can doi token:\n  // brute-test-001\n  // brute-test-002\n  // brute-test-003...\n  token: 'brute-test-009'\n};\n\nif (\n  LAB_RESET.enabled &&\n  LAB_RESET.ip &&\n  staticData.labResetTokens[LAB_RESET.ip] !== LAB_RESET.token\n) {\n  // Xoa IP test khoi danh sach da xu ly\n  staticData.blocked =\n    staticData.blocked.filter(ip =>\n      ip !== LAB_RESET.ip\n    );\n\n  // Nho token de chi reset MOT LAN\n  staticData.labResetTokens[LAB_RESET.ip] =\n    LAB_RESET.token;\n}\n\n// ================================================================\n// LOC IP CHUA XU LY\n// ================================================================\n\nconst newIps = [];\n\nfor (const ip of ips) {\n\n  if (!staticData.blocked.includes(ip)) {\n\n    staticData.blocked.push(ip);\n\n    newIps.push(ip);\n  }\n}\n\n// ================================================================\n// KHONG CO IP MOI\n// ================================================================\n\nif (newIps.length === 0) {\n\n  return [{\n    json: {\n      no_new_ip: true,\n      reason: 'IP_ALREADY_PROCESSED',\n      attack_type: 'BRUTE_FORCE',\n      blocked_ips: staticData.blocked\n    }\n  }];\n}\n\n// ================================================================\n// CO IP CAN XU LY\n// ================================================================\n\nreturn newIps.map(ip => ({\n\n  json: {\n\n    no_new_ip: false,\n\n    ip,\n\n    reason:\n      'SSH Brute-force detected by n8n analyzer',\n\n    attack_type:\n      'BRUTE_FORCE',\n\n    telegram_text:\n`⚠️ CẢNH BÁO BẢO MẬT\nPhát hiện tấn công SSH Brute-force\nIP tấn công: ${ip}\nHành động: Đã tự động chặn IP qua Ansible`\n\n  }\n\n}));"
      },
