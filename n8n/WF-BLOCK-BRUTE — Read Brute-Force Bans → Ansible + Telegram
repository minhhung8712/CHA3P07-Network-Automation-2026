        "jsCode": "// ================================================================\n// PREPARE METRICS - BLOCK_BRUTE\n// KPI: Analyzer detected -> Ansible success\n// ================================================================\n\nconst metric = {\n  schema_version: 1,\n\n  scenario: 'BLOCK_BRUTE',\n  event_id: $json.event_id || null,\n\n  ip: $json.ip,\n  attack_type: $json.attack_type || 'BRUTE_FORCE',\n  status: $json.status || 'success',\n\n  // Moc bat dau: WF-ANALYZER phat hien\n  analyzer_detected_at_ms: $json.analyzer_detected_at_ms,\n  analyzer_detected_at: $json.analyzer_detected_at,\n\n  // Moc ket thuc: Ansible success\n  processing_finished_at_ms: $json.processing_finished_at_ms,\n  processing_finished_at: $json.processing_finished_at,\n\n  // KPI chinh\n  total_processing_ms: $json.total_processing_ms,\n  total_processing_seconds: $json.total_processing_seconds\n};\n\nreturn [{\n  json: {\n    ...$json,\n    metrics_content: JSON.stringify(metric) + '\\n'\n  }\n}];"
      },
