    {
      "parameters": {
        "jsCode": "const context = $('Find Analyzer Event').item.json;\n\nconst start = Number(context.analyzer_detected_at_ms);\nconst end = Date.now();\n\nif (!Number.isFinite(start)) {\n  throw new Error('Khong tim thay analyzer_detected_at_ms');\n}\n\nconst totalMs = end - start;\n\nreturn [{\n  json: {\n    ...context,\n\n    status: 'success',\n\n    processing_started_at_ms: start,\n    processing_started_at: context.analyzer_detected_at,\n\n    processing_finished_at_ms: end,\n    processing_finished_at: new Date(end).toISOString(),\n\n    total_processing_ms: totalMs,\n    total_processing_seconds:\n      Number((totalMs / 1000).toFixed(3))\n  }\n}];"
      },
