      "parameters": {
        "jsCode": "// ================================================================\n// WF-BLOCK-BRUTE - FIND ANALYZER EVENT\n// Match IP tu BanIP_Bruteforce voi event BRUTE_FORCE moi nhat\n// ================================================================\n\n// IP vua duoc Filter New IPs cho phep xu ly\nconst block = $('Filter New IPs (Session)').item.json;\nconst ip = String(block.ip || '').trim();\n\n// Noi dung BanEvent_Bruteforce.jsonl\nconst text = $('Extract Event Text').first()?.json?.data || '';\n\nif (!ip) {\n  throw new Error('Khong tim thay IP tu Filter New IPs (Session)');\n}\n\n// Doc tung dong JSONL\nconst events = text\n  .split(/\\r?\\n/)\n  .map(line => line.trim())\n  .filter(Boolean)\n  .map(line => {\n    try {\n      return JSON.parse(line);\n    } catch {\n      return null;\n    }\n  })\n  .filter(event =>\n    event &&\n    event.src_ip === ip &&\n    event.event_type === 'BRUTE_FORCE'\n  )\n  .sort(\n    (a, b) =>\n      Number(b.analyzer_detected_at_ms || 0) -\n      Number(a.analyzer_detected_at_ms || 0)\n  );\n\n// Lay event BRUTE_FORCE moi nhat cua IP\nconst event = events[0] || null;\n\n// Neu khong tim thay metadata van cho phep xu ly block\nif (!event) {\n  return [{\n    json: {\n      ...block,\n      metrics_found: false,\n      event_id: null,\n      analyzer_detected_at_ms: null,\n      analyzer_detected_at: null,\n      source_event_at_ms: null,\n      source_event_at: null\n    }\n  }];\n}\n\n// Co event -> mang timestamp tu WF-ANALYZER sang\nreturn [{\n  json: {\n    ...block,\n\n    metrics_found: true,\n\n    event_id: event.event_id,\n\n    scenario:\n      event.scenario || 'BLOCK_BRUTE',\n\n    metric:\n      event.metric ?? null,\n\n    // t2 - Analyzer phat hien vuot nguong\n    analyzer_detected_at_ms:\n      event.analyzer_detected_at_ms,\n\n    analyzer_detected_at:\n      event.analyzer_detected_at,\n\n    // Moc log threshold - giu lai neu sau nay can nghien cuu\n    source_event_at_ms:\n      event.source_event_at_ms ?? null,\n\n    source_event_at:\n      event.source_event_at ?? null,\n\n    source_to_analyzer_ms:\n      event.source_to_analyzer_ms ?? null\n  }\n}];"
      },
