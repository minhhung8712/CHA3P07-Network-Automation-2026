      "parameters": {
        "jsCode": "// ================================================================\n// FILTER NEW IPs + LAB RESET\n// Production: van dedupe IP nhu cu\n// Lab: cho phep reset 1 IP de test lai\n// ================================================================\n\nconst content = $('Extract Ban Text').first()?.json?.data || '';\nconst ips = content.split(/\\r?\\n/).map(s => s.trim()).filter(Boolean);\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.blocked = Array.isArray(staticData.blocked) ? staticData.blocked : [];\nstaticData.labResetTokens = staticData.labResetTokens || {};\n\n// ================================================================\n// LAB RESET\n// Muon test lai cung IP -> chi can doi token\n// ================================================================\n\nconst LAB_RESET = {\n  enabled: true,\n  ip: '192.168.183.133',\n  token: 'scan-test-013'\n};\n\nif (\n  LAB_RESET.enabled &&\n  LAB_RESET.ip &&\n  staticData.labResetTokens[LAB_RESET.ip] !== LAB_RESET.token\n) {\n  // Xoa IP khoi session blocked\n  staticData.blocked = staticData.blocked.filter(ip => ip !== LAB_RESET.ip);\n\n  // Nho token de chi reset 1 lan\n  staticData.labResetTokens[LAB_RESET.ip] = LAB_RESET.token;\n}\n\n// ================================================================\n// LOC IP MOI\n// ================================================================\n\nconst newIps = [];\n\nfor (const ip of ips) {\n  if (!staticData.blocked.includes(ip)) {\n    staticData.blocked.push(ip);\n    newIps.push(ip);\n  }\n}\n\n// ================================================================\n// KHONG CO IP MOI\n// ================================================================\n\nif (newIps.length === 0) {\n  return [{\n    json: {\n      no_new_ip: true,\n      reason: 'IP_ALREADY_PROCESSED',\n      blocked_ips: staticData.blocked\n    }\n  }];\n}\n\n// ================================================================\n// CO IP MOI -> DI NHANH FALSE\n// ================================================================\n\nreturn newIps.map(ip => ({\n  json: {\n    no_new_ip: false,\n    ip,\n    reason: 'PORT_SCAN detected by n8n analyzer',\n    attack_type: 'PORT_SCAN'\n  }\n}));"
      },
      "id": "d9a1d9bf-58f3-400b-8220-ea4d96847bdf",
      "name": "Filter New IPs (Session)",
      "type": "n8n-nodes-base.code",
