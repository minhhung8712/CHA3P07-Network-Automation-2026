      "id": "d4e0d6ad-868d-4c4c-b950-b8e3b74290f0",
      "name": "Extract Event Text"
    },
    {
      "parameters": {
        "jsCode": "const ip = $('Filter New IPs (Session)').item.json.ip;\nconst text = $('Extract Event Text').first()?.json?.data || '';\n\nconst events = text\n  .split(/\\r?\\n/)\n  .map(x => x.trim())\n  .filter(Boolean)\n  .map(line => {\n    try { return JSON.parse(line); }\n    catch { return null; }\n  })\n  .filter(e =>\n    e &&\n    e.src_ip === ip &&\n    e.event_type === 'PORT_SCAN'\n  )\n  .sort((a, b) =>\n    Number(b.analyzer_detected_at_ms || 0) -\n    Number(a.analyzer_detected_at_ms || 0)\n  );\n\nconst event = events[0];\n\nif (!event) {\n  return [{\n    json: {\n      ...$('Filter New IPs (Session)').item.json,\n      metrics_found: false\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...$('Filter New IPs (Session)').item.json,\n\n    metrics_found: true,\n\n    event_id: event.event_id,\n\n    analyzer_detected_at_ms:\n      event.analyzer_detected_at_ms,\n\n    analyzer_detected_at:\n      event.analyzer_detected_at,\n\n    source_event_at_ms:\n      event.source_event_at_ms,\n\n    source_event_at:\n      event.source_event_at\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
