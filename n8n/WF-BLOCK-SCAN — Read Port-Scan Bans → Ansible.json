    {
      "parameters": {
        "jsCode": "// ================================================================\n// END-TO-END TIMER\n// WF-ANALYZER detected -> Ansible success\n// ================================================================\n\nconst context = $('Find Analyzer Event').item.json;\n\nconst start = Number(context.analyzer_detected_at_ms);\nconst end = Date.now();\n\nif (!Number.isFinite(start)) {\n  throw new Error('Khong tim thay analyzer_detected_at_ms');\n}\n\nconst totalMs = end - start;\n\nreturn [{\n  json: {\n    ...context,\n\n    status: 'success',\n\n    processing_started_at_ms: start,\n    processing_started_at: context.analyzer_detected_at,\n\n    processing_finished_at_ms: end,\n    processing_finished_at: new Date(end).toISOString(),\n\n    total_processing_ms: totalMs,\n    total_processing_seconds: Number((totalMs / 1000).toFixed(3))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        160
      ],
      "id": "a8dd317a-147d-49c0-8ae5-525e4715d9e8",
      "name": "End Processing Timer"
    },
    {
      "parameters": {
        "jsCode": "// ================================================================\n// PREPARE METRICS - BLOCK_SCAN\n// KPI: Analyzer detected -> Ansible success\n// ================================================================\n\nconst metric = {\n  schema_version: 1,\n\n  scenario: 'BLOCK_SCAN',\n  event_id: $json.event_id || null,\n\n  ip: $json.ip,\n  attack_type: $json.attack_type || 'PORT_SCAN',\n  status: $json.status || 'success',\n\n  // Moc bat dau: WF-ANALYZER phat hien\n  analyzer_detected_at_ms: $json.analyzer_detected_at_ms,\n  analyzer_detected_at: $json.analyzer_detected_at,\n\n  // Moc ket thuc: Ansible success\n  processing_finished_at_ms: $json.processing_finished_at_ms,\n  processing_finished_at: $json.processing_finished_at,\n\n  // KPI chinh\n  total_processing_ms: $json.total_processing_ms,\n  total_processing_seconds: $json.total_processing_seconds\n};\n\nreturn [{\n  json: {\n    ...$json,\n    metrics_content: JSON.stringify(metric) + '\\n'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
