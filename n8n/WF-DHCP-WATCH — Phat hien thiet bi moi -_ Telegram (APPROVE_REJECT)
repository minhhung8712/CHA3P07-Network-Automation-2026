      "parameters": {
        "jsCode": "// ================================================================\n// WF-DHCP-WATCH — PHAT HIEN THIET BI MOI TU DU LIEU DHCP DO WF-ANALYZER GUI SANG\n// ================================================================\n// THAY DOI: khong con tu doc dhcp.log (da bi loai bo o pf_collector.py va\n// khong con tach rieng o WF-ANALYZER nua). Workflow nay gio duoc goi bang\n// Execute Workflow Trigger, nhan san noi dung dhcp_content (cac dong log\n// DHCP da duoc WF-ANALYZER loc san tu pfsense.log) ngay trong input.\n//\n// Sua loi (giu nguyen tu ban truoc):\n// - DHCPDISCOVER thuong khong co hostname\n// - Khong danh dau seen ngay tai dong dau tien\n// - Gom tat ca log cua cung mot MAC\n// - Lay hostname bo sung tu DHCPREQUEST / DHCPOFFER / DHCPACK\n// ================================================================\n\n// Doc tat ca item cua node (dung cho Approved/Rejected/Pending)\nconst readNodeText = (nodeName) => {\n  try {\n    return $(nodeName)\n      .all()\n      .map(item => String(item.json?.data || ''))\n      .filter(Boolean)\n      .join('\\n');\n  } catch (error) {\n    return '';\n  }\n};\n\n// DHCP content lay truc tiep tu input cua Execute Workflow Trigger,\n// khong doc file nua\nconst dhcp = String($('Nhan DHCP tu WF-ANALYZER').first().json.dhcp_content || '');\n\nconst approvedTxt = readNodeText('Extract Approved');\nconst rejectedTxt = readNodeText('Extract Rejected');\nconst pendingTxt  = readNodeText('Extract Pending');\n\n// ================================================================\n// 1. Tao danh sach MAC da biet\n// ================================================================\n\nconst normalizeMac = (mac) => String(mac || '').trim().toLowerCase();\n\nconst macOf = (line) => {\n  const firstColumn = String(line || '').split(',')[0];\n  return normalizeMac(firstColumn);\n};\n\nconst known = new Set();\n\nfor (const txt of [approvedTxt, rejectedTxt, pendingTxt]) {\n  for (const line of txt.split(/\\r?\\n/)) {\n    const mac = macOf(line);\n\n    if (mac) {\n      known.add(mac);\n    }\n  }\n}\n\n// ================================================================\n// 2. Doc log va gom thong tin theo tung MAC\n// ================================================================\n\nconst RE_MAC = /([0-9a-f]{2}(?::[0-9a-f]{2}){5})/i;\nconst RE_EVENT = /\\b(DHCPDISCOVER|DHCPREQUEST|DHCPOFFER|DHCPACK)\\b/i;\n\nconst devices = new Map();\nconst lines = dhcp.split(/\\r?\\n/);\n\nfor (const raw of lines) {\n  const line = raw.trim();\n\n  if (!line) continue;\n\n  const eventMatch = line.match(RE_EVENT);\n  if (!eventMatch) continue;\n\n  const event = eventMatch[1].toUpperCase();\n\n  const macMatch = line.match(RE_MAC);\n  if (!macMatch) continue;\n\n  const mac = normalizeMac(macMatch[1]);\n\n  if (!devices.has(mac)) {\n    devices.set(mac, {\n      mac,\n      hostname: '',\n      requestSeen: false,\n      events: [],\n      hostnameSource: '',\n    });\n  }\n\n  const device = devices.get(mac);\n\n  // Chi coi la thiet bi dang yeu cau vao mang neu co DISCOVER hoac REQUEST\n  if (event === 'DHCPDISCOVER' || event === 'DHCPREQUEST') {\n    device.requestSeen = true;\n  }\n\n  device.events.push(event);\n\n  // Chi tim dau ngoac nam SAU dia chi MAC\n  // Tranh lay nham cac noi dung ngoac khac trong log\n  const macEndIndex = macMatch.index + macMatch[0].length;\n  const textAfterMac = line.slice(macEndIndex);\n\n  const hostnameMatch = textAfterMac.match(/^\\s*\\(([^)]+)\\)/);\n\n  if (hostnameMatch) {\n    const hostname = hostnameMatch[1].trim();\n\n    // Bo qua mot so gia tri khong phai hostname neu co\n    if (\n      hostname &&\n      hostname.toLowerCase() !== 'found' &&\n      hostname.toLowerCase() !== 'unknown'\n    ) {\n      device.hostname = hostname;\n      device.hostnameSource = event;\n    }\n  }\n}\n\n// ================================================================\n// 3. Chi lay MAC moi, chua tung approved/rejected/pending\n// ================================================================\n\nconst newMacs = [];\n\nfor (const device of devices.values()) {\n  if (!device.requestSeen) continue;\n  if (known.has(device.mac)) continue;\n\n  newMacs.push(device);\n}\n\n// ================================================================\n// 4. Khong co MAC moi\n// ================================================================\n\nif (newMacs.length === 0) {\n  return [\n    {\n      json: {\n        no_new: true,\n        scanned: lines.length,\n        parsed_devices: Array.from(devices.values()),\n      },\n    },\n  ];\n}\n\n// ================================================================\n// 5. Tao payload Telegram\n// ================================================================\n\nreturn newMacs.map(device => {\n  const hostname = device.hostname || '';\n\n  const text =\n    '⚠️ THIẾT BỊ MỚI YÊU CẦU VÀO MẠNG (VLAN2)\\n' +\n    'MAC: ' + device.mac + '\\n' +\n    'Hostname: ' + (hostname || ' ') + '\\n\\n' +\n    'Chọn APPROVE để cấp IP, REJECT để chặn.';\n\n  return {\n    json: {\n      mac: device.mac,\n      hostname,\n\n      hostname_source: device.hostnameSource,\n      dhcp_events: [...new Set(device.events)],\n\n      pending_line:\n        device.mac + ',' + hostname + '\\n',\n\n      telegram_text: text,\n\n      reply_markup: {\n        inline_keyboard: [\n          [\n            {\n              text: '✅ APPROVE',\n              callback_data: 'approve|' + device.mac,\n            },\n            {\n              text: '⛔ REJECT',\n              callback_data: 'reject|' + device.mac,\n            },\n          ],\n        ],\n      },\n    },\n  };\n});"
      },
